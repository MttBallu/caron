# Copy to .env and fill in your dedicated Neo4j experiment connection.
# Keep the URI scheme supplied by your server (for example bolt:// or neo4j+s://).
CARON_NEO4J_EXPERIMENT_URI=bolt://localhost:7687
CARON_NEO4J_EXPERIMENT_USER=neo4j
CARON_NEO4J_EXPERIMENT_PASSWORD=replace-me
CARON_NEO4J_EXPERIMENT_DATABASE=neo4j
